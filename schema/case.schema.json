{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/<org>/enterprise-ai-casebook/schema/case.schema.json",
  "title": "Enterprise AI Case",
  "type": "object",
  "required": [
    "id", "title", "company", "industry", "scenario",
    "deployment_model", "fde_involved", "ai_tech", "scale",
    "start_date", "status", "evidence_grade", "last_verified",
    "metrics", "sources", "confidence_notes",
    "tags", "replicability", "human_in_loop"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+){2,}$",
      "description": "{industry}-{company}-{scene}，全小写连字符"
    },
    "title": { "type": "string", "minLength": 6, "maxLength": 60 },
    "company": { "type": "string", "minLength": 2 },
    "company_hq": { "type": "string" },
    "industry": {
      "type": "string",
      "enum": [
        "financial-services", "healthcare", "manufacturing", "retail",
        "software-internet", "telecom", "logistics", "energy",
        "public-sector", "professional-services", "pharma-biotech",
        "education", "real-estate", "agriculture"
      ]
    },
    "sub_industry": { "type": "string" },
    "scenario": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "customer-support", "knowledge-retrieval", "sales-enablement",
          "software-engineering", "document-processing", "clinical-documentation",
          "clinical-decision", "manufacturing-quality", "scheduling-optimization",
          "predictive-maintenance", "supply-chain", "risk-compliance",
          "marketing-content", "backoffice-automation", "field-service",
          "coding-agent", "data-analysis", "procurement"
        ]
      }
    },
    "deployment_model": {
      "type": "string",
      "enum": ["vendor-saas", "vendor-copilot", "platform-build", "in-house", "si-delivery"]
    },
    "fde_involved": {
      "type": "string",
      "enum": ["none", "vendor-embedded", "si-partner", "in-house", "unknown"]
    },
    "ai_tech": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["LLM", "RAG", "ASR", "CV", "agent", "predictive-ml", "rules", "digital-twin"]
      }
    },
    "vendor": { "type": "array", "items": { "type": "string" } },
    "scale": { "type": "string", "minLength": 2 },
    "start_date": { "type": "string", "pattern": "^([0-9]{4}(-[0-9]{2})?|unknown)$" },
    "status": { "type": "string", "enum": ["pilot", "production", "scaled", "paused", "retracted"] },
    "evidence_grade": { "type": "string", "enum": ["A", "B", "C", "D", "X"] },
    "last_verified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "value", "baseline", "method", "direction"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" },
          "unit": { "type": "string" },
          "baseline": {
            "type": "string",
            "minLength": 2,
            "description": "无基线时必须显式写 未披露"
          },
          "method": {
            "type": "string",
            "minLength": 8,
            "description": "怎么算、谁算、样本量"
          },
          "window": { "type": "string" },
          "direction": {
            "type": "string",
            "enum": ["cost-down", "effort-down", "time-down", "volume-up",
                     "revenue-up", "quality-up", "adoption", "risk-down"]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "grade", "url", "accessed"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
          "type": {
            "type": "string",
            "enum": [
              "annual-report", "earnings-call", "regulatory-filing",
              "peer-reviewed", "official-press-release", "official-case-study",
              "official-careers-page", "company-blog", "conference-talk",
              "media-report", "aggregator"
            ]
          },
          "grade": { "type": "string", "enum": ["A", "B", "C", "D"] },
          "url": { "type": "string", "pattern": "^https?://" },
          "publisher": { "type": "string" },
          "published": { "type": "string" },
          "accessed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "note": { "type": "string" }
        }
      }
    },
    "confidence_notes": { "type": "string", "minLength": 4 },
    "tags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "replicability": { "type": "integer", "minimum": 1, "maximum": 5 },
    "human_in_loop": {
      "type": "string",
      "enum": ["none", "review-before-send", "escalation-only", "sampling-audit"]
    }
  }
}
